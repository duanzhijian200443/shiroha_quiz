<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../../tool/android_device_adapter/*.cs" Exclude="../../../../../tool/android_device_adapter/Program.cs" />
    <EmbeddedResource Include="../../../../../tool/android_device_adapter/fixtures/public-certificates.json" />
  </ItemGroup>
</Project>
