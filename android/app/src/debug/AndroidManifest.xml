<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application>
        <service android:name="com.example.shiroha_quiz.external.DeviceReadService"
            android:enabled="${androidReadBackgroundEnabled}"
            android:exported="false" android:stopWithTask="true"
            android:foregroundServiceType="connectedDevice" />
        <activity
            android:name="com.example.shiroha_quiz.external.DeviceNativeProofActivity"
            android:enabled="${androidNativeProofEnabled}"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:label="Shiroha Native validation" />
    </application>
</manifest>
