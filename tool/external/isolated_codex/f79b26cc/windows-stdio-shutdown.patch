+use super::*;
+use crate::stdio_server_launcher::LocalStdioServerLauncher;
+use crate::windows_stdio_shutdown::CloseCompletion;
+use rmcp::model::{ClientCapabilities, Implementation};
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::path::Path;
+
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn OpenProcess(access: u32, inherit: i32, pid: u32) -> *mut std::ffi::c_void;
+    fn WaitForSingleObject(handle: *mut std::ffi::c_void, milliseconds: u32) -> u32;
+    fn GetExitCodeProcess(handle: *mut std::ffi::c_void, code: *mut u32) -> i32;
+}
+
+fn process_handle(pid: u32) -> io::Result<OwnedHandle> {
+    let handle = unsafe { OpenProcess(0x0010_1000, 0, pid) };
+    if handle.is_null() {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { OwnedHandle::from_raw_handle(handle) })
+}
+
+fn exited(handle: &OwnedHandle) -> io::Result<u32> {
+    if unsafe { WaitForSingleObject(handle.as_raw_handle(), 1_000) } != 0 {
+        return Err(io::Error::other("original process is still alive"));
+    }
+    let mut code = 259;
+    if unsafe { GetExitCodeProcess(handle.as_raw_handle(), &mut code) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(code)
+}
