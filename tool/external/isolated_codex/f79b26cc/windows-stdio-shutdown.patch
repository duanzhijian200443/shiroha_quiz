+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn hung_shutdown_is_bounded_and_concurrent_callers_keep_original_failure() -> Result<()> {
+    let (client, directory, handle) = client("hang", McpProtocolMode::Legacy, false).await?;
+    let other = Arc::clone(&client);
+    let start = Instant::now();
+    let (first, second) = tokio::join!(
+        client.shutdown_for(StdioTermination::Shutdown),
+        other.shutdown_for(StdioTermination::Shutdown)
+    );
+    let first = first.expect_err("hung child cannot be a successful close");
+    let second = second.expect_err("concurrent caller cannot hide failure");
+    assert_eq!(first.kind(), io::ErrorKind::TimedOut);
+    assert_eq!(first.to_string(), second.to_string());
+    assert!(start.elapsed() < Duration::from_secs(9));
+    assert_ne!(exited(&handle)?, 0);
+    assert!(!std::fs::read_to_string(directory.path().join("close.txt"))?.contains("terminal"));
+    let repeated = client
+        .shutdown_for(StdioTermination::Shutdown)
+        .await
+        .expect_err("failure is stable");
+    assert_eq!(repeated.to_string(), first.to_string());
+    Ok(())
+}
