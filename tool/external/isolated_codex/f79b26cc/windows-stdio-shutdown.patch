+//! Private completion state for the original Windows local stdio close.
+//! Service cancellation is not evidence that process/pipe cleanup succeeded.
+
+use std::io;
+use std::sync::Arc;
+use std::sync::OnceLock;
+
+use futures::future::BoxFuture;
+use futures::future::Shared;
+use tokio::sync::watch;
+
+pub(super) type CloseResult = Result<(), Arc<io::Error>>;
+pub(super) type CloseWorker = Shared<BoxFuture<'static, CloseResult>>;
+
+pub(super) struct CloseCompletion {
+    result: OnceLock<CloseResult>,
+    changed: watch::Sender<bool>,
+}
+
+impl Default for CloseCompletion {
+    fn default() -> Self {
+        Self {
+            result: OnceLock::new(),
+            changed: watch::channel(false).0,
+        }
+    }
+}
+
+impl CloseCompletion {
+    // The first terminal result wins, including a timeout before a late close.
+    pub(super) fn complete(&self, result: CloseResult) {
+        if self.result.set(result).is_ok() {
+            self.changed.send_replace(true);
+        }
+    }
+
+    pub(super) async fn wait(&self) -> CloseResult {
+        let mut changed = self.changed.subscribe();
+        loop {
+            if let Some(result) = self.result.get() {
+                return result.clone();
+            }
+            if changed.changed().await.is_err() {
+                return Err(Arc::new(io::Error::other("stdio close observer lost")));
+            }
+        }
+    }
+}
+
+pub(super) fn copy_error(error: Arc<io::Error>) -> io::Error {
+    io::Error::new(error.kind(), error.to_string())
+}
