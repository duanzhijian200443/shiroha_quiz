+#[tokio::test]
+async fn first_close_failure_cannot_be_replaced_by_late_success() {
+    let completion = CloseCompletion::default();
+    completion.complete(Err(Arc::new(io::Error::new(
+        io::ErrorKind::TimedOut,
+        "original timeout",
+    ))));
+    completion.complete(Ok(()));
+    assert_eq!(
+        completion.wait().await.expect_err("latched").kind(),
+        io::ErrorKind::TimedOut
+    );
