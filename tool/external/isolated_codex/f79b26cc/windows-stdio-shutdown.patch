+    let child =
+        process_handle(std::fs::read_to_string(directory.path().join("child.pid"))?.parse()?)?;
+    assert_eq!(
+        std::fs::read_to_string(directory.path().join("breakaway.txt"))?,
+        "denied"
+    );
+    client.shutdown_for(StdioTermination::Shutdown).await?;
+    assert_eq!(
+        std::fs::read_to_string(directory.path().join("close.txt"))?,
+        "eof\ncleanup_begin\ncleanup_end\nterminal\n"
