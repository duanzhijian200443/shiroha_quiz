@@ -0,0 +1,72 @@
+use super::*;
+
+#[cfg(windows)]
+fn server(exit_code: i32, hang: bool) -> GracefulStdio {
+    let body = if hang {
+        "[Threading.Thread]::Sleep(30000)".to_string()
+    } else {
+        format!(
+            "[Console]::In.ReadToEnd() | Out-Null; [Console]::Out.WriteLine(''); [Console]::Error.Write('drain'); exit {exit_code}"
+        )
+    };
+    let mut command = Command::new("powershell.exe");
+    command.args(["-NoProfile", "-NonInteractive", "-Command", &body]);
+    command
+        .kill_on_drop(true)
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped());
+    GracefulStdio::spawn(command).unwrap()
+}
+
+#[cfg(windows)]
+#[tokio::test]
+async fn eof_and_original_exit_settle_before_success() {
+    let mut transport = server(/*exit_code*/ 0, /*hang*/ false);
+    let control = transport.control();
+    let (closed, message) = tokio::join!(control.shutdown(), transport.receive());
+    closed.unwrap();
+    assert!(message.is_none());
+    assert!(transport.child.try_wait().unwrap().unwrap().success());
+    transport.close().await.unwrap();
+    transport.control().shutdown().await.unwrap();
+}
+
+#[cfg(windows)]
+#[tokio::test]
+async fn lost_transport_wakes_retained_closer_with_failure() {
+    let transport = server(/*exit_code*/ 0, /*hang*/ true);
+    let control = transport.control();
+    drop(transport);
+    let result = tokio::time::timeout(Duration::from_secs(1), control.shutdown())
+        .await
+        .unwrap();
+    assert_eq!(result.unwrap_err().kind(), io::ErrorKind::BrokenPipe);
+    assert!(control.shutdown().await.is_err());
+}
+
+#[cfg(windows)]
+#[tokio::test]
+async fn abnormal_exit_remains_failed_for_every_closer() {
+    let mut transport = server(/*exit_code*/ 23, /*hang*/ false);
+    assert!(transport.close().await.is_err());
+    assert_eq!(
+        transport.child.try_wait().unwrap().unwrap().code(),
+        Some(23)
+    );
+    assert!(transport.control().shutdown().await.is_err());
+}
+
+#[cfg(windows)]
+#[tokio::test]
+async fn forced_fallback_is_latched_failure_not_success() {
+    let mut transport = server(/*exit_code*/ 0, /*hang*/ true);
+    assert_eq!(
+        transport.close().await.unwrap_err().kind(),
+        io::ErrorKind::TimedOut
+    );
+    assert_eq!(
+        transport.control().shutdown().await.unwrap_err().kind(),
+        io::ErrorKind::TimedOut
+    );
+    assert!(transport.child.try_wait().unwrap().is_some());
+}
