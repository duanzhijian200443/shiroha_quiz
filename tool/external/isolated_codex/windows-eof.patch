@@ -0,0 +1,220 @@
+//! Original-child EOF and settlement for the isolated local MCP client.
+use std::io;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::task::{Context, Poll};
+use std::time::Duration;
+
+use rmcp::service::{RoleClient, RxJsonRpcMessage, TxJsonRpcMessage};
+use rmcp::transport::Transport;
+use rmcp::transport::async_rw::AsyncRwTransport;
+use tokio::io::{AsyncRead, ReadBuf};
+use tokio::process::{Child, ChildStdin, ChildStdout, Command};
+use tokio::sync::watch;
+use tokio::task::JoinHandle;
+
+type Outcome = Result<(), io::ErrorKind>;
+
+pub(crate) struct CloseControl {
+    requested: watch::Sender<bool>,
+    settled: watch::Sender<Option<Outcome>>,
+}
+
+impl CloseControl {
+    pub(crate) fn request(&self) {
+        self.requested.send_replace(true);
+    }
+
+    pub(crate) async fn shutdown(&self) -> io::Result<()> {
+        self.request();
+        let mut result = self.settled.subscribe();
+        loop {
+            if let Some(outcome) = *result.borrow_and_update() {
+                return as_io(outcome);
+            }
+            result
+                .changed()
+                .await
+                .map_err(|_| io::Error::other("MCP close owner lost"))?;
+        }
+    }
+}
+
+fn as_io(outcome: Outcome) -> io::Result<()> {
+    outcome.map_err(|kind| io::Error::new(kind, "MCP original child did not settle cleanly"))
+}
+
+struct ObservedStdout {
+    pipe: ChildStdout,
+    eof: Arc<AtomicBool>,
+    failed: Arc<AtomicBool>,
+}
+impl AsyncRead for ObservedStdout {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        let before = buf.filled().len();
+        let capacity = buf.remaining();
+        let result = Pin::new(&mut self.pipe).poll_read(cx, buf);
+        match &result {
+            Poll::Ready(Ok(())) if capacity != 0 && buf.filled().len() == before => {
+                self.eof.store(true, Ordering::Release);
+            }
+            Poll::Ready(Err(_)) => {
+                self.failed.store(true, Ordering::Release);
+            }
+            _ => {}
+        }
+        result
+    }
+}
+
+pub(crate) struct GracefulStdio {
+    transport: AsyncRwTransport<RoleClient, ObservedStdout, ChildStdin>,
+    child: Child,
+    stderr: Option<JoinHandle<io::Result<u64>>>,
+    control: Arc<CloseControl>,
+    requests: watch::Receiver<bool>,
+    eof: Arc<AtomicBool>,
+    failed: Arc<AtomicBool>,
+}
+
+impl GracefulStdio {
+    pub(crate) fn spawn(mut command: Command) -> io::Result<Self> {
+        command.stderr(std::process::Stdio::piped());
+        let mut child = command.spawn()?;
+        let input = child
+            .stdin
+            .take()
+            .ok_or_else(|| io::Error::other("MCP stdin missing"))?;
+        let output = child
+            .stdout
+            .take()
+            .ok_or_else(|| io::Error::other("MCP stdout missing"))?;
+        let mut errors = child
+            .stderr
+            .take()
+            .ok_or_else(|| io::Error::other("MCP stderr missing"))?;
+        let stderr =
+            tokio::spawn(async move { tokio::io::copy(&mut errors, &mut tokio::io::sink()).await });
+        let (requested, requests) = watch::channel(false);
+        let (settled, _) = watch::channel(None);
+        let control = Arc::new(CloseControl { requested, settled });
+        let eof = Arc::new(AtomicBool::new(false));
+        let failed = Arc::new(AtomicBool::new(false));
+        let transport = AsyncRwTransport::new(
+            ObservedStdout {
+                pipe: output,
+                eof: Arc::clone(&eof),
+                failed: Arc::clone(&failed),
+            },
+            input,
+        );
+        Ok(Self {
+            transport,
+            child,
+            stderr: Some(stderr),
+            control,
+            requests,
+            eof,
+            failed,
+        })
+    }
+
+    pub(crate) fn control(&self) -> Arc<CloseControl> {
+        Arc::clone(&self.control)
+    }
+
+    async fn finish(&mut self) -> io::Result<()> {
+        if let Some(outcome) = *self.control.settled.borrow() {
+            return as_io(outcome);
+        }
+        // Same writer is withdrawn first. The same reader drains, without a
+        // parallel stdout consumer. All three original resources must settle.
+        let result = tokio::time::timeout(Duration::from_secs(5), async {
+            self.transport.close().await?;
+            while self.transport.receive().await.is_some() {}
+            let status = self.child.wait().await?;
+            if let Some(errors) = self.stderr.as_mut() {
+                errors.await.map_err(io::Error::other)??;
+            }
+            if !status.success()
+                || !self.eof.load(Ordering::Acquire)
+                || self.failed.load(Ordering::Acquire)
+            {
+                return Err(io::Error::other("MCP exit or stream failed"));
+            }
+            Ok(())
+        })
+        .await;
+        let outcome = match result {
+            Ok(Ok(())) => Ok(()),
+            Ok(Err(error)) => Err(error.kind()),
+            Err(_) => Err(io::ErrorKind::TimedOut),
+        };
+        if outcome.is_err() {
+            // Original Child handle only. Forced cleanup never becomes Ok,
+            // and the result remains latched for every explicit closer.
+            if self.child.try_wait().ok().flatten().is_none() {
+                let _ = tokio::time::timeout(Duration::from_secs(2), self.child.kill()).await;
+            }
+            if let Some(errors) = self.stderr.as_mut()
+                && !errors.is_finished()
+            {
+                errors.abort();
+                let _ = errors.await;
+            }
+        }
+        self.control.settled.send_replace(Some(outcome));
+        as_io(outcome)
+    }
+}
+
+impl Transport<RoleClient> for GracefulStdio {
+    type Error = io::Error;
+    fn send(
+        &mut self,
+        item: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = io::Result<()>> + Send + 'static {
+        self.transport.send(item)
+    }
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        if *self.requests.borrow_and_update() {
+            let _ = self.finish().await;
+            return None;
+        }
+        tokio::select! {
+            _ = self.requests.changed() => {
+                let _ = self.finish().await;
+                None
+            }
+            message = self.transport.receive() => message,
+        }
+    }
+    async fn close(&mut self) -> io::Result<()> {
+        self.finish().await
+    }
+}
+
+impl Drop for GracefulStdio {
+    fn drop(&mut self) {
+        // Initialization/cancellation can drop the transport before close.
+        // Child::kill_on_drop remains a failure fallback, never a clean drain.
+        // Wake every retained process handle instead of leaving shutdown hung.
+        if self.control.settled.borrow().is_none() {
+            self.control
+                .settled
+                .send_replace(Some(Err(io::ErrorKind::BrokenPipe)));
+        }
+        if let Some(errors) = &self.stderr {
+            errors.abort();
+        }
+    }
+}
+
